<Page x:Class="EverythingToolbar.Statistics.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:behaviors="clr-namespace:EverythingToolbar.Behaviors"
      xmlns:statistics="clr-namespace:EverythingToolbar.Statistics"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False">

    <b:Interaction.Behaviors>
        <behaviors:WpfUiBehavior />
    </b:Interaction.Behaviors>

    <ScrollViewer>
        <Grid Margin="40,40,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Title + Refresh -->
                <RowDefinition Height="Auto" />  <!-- Filters -->
                <RowDefinition Height="Auto" />  <!-- Summary cards -->
                <RowDefinition Height="Auto" />  <!-- Distribution header -->
                <RowDefinition Height="Auto" />  <!-- Charts -->
                <RowDefinition Height="Auto" />  <!-- Drives header -->
                <RowDefinition Height="Auto" />  <!-- Drives -->
            </Grid.RowDefinitions>

            <!-- ── Title + Refresh ────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <ui:TextBlock FontTypography="Title" Text="Statistics" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:TextBlock Name="StatusText"
                                  FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                    <ui:Button Name="RefreshButton"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Content="Refresh"
                               Click="OnRefreshClicked" />
                </StackPanel>
            </Grid>

            <!-- ── Filter bar ─────────────────────────────────────────────── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16,12" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- label -->
                        <ColumnDefinition Width="*" />     <!-- path box -->
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />  <!-- label -->
                        <ColumnDefinition Width="180" />   <!-- size combo -->
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />  <!-- apply button -->
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  FontTypography="Body"
                                  Text="Folder:" />

                    <ui:TextBox Grid.Column="1"
                                Name="PathFilterBox"
                                PlaceholderText="All drives  (e.g. C:\Projects)"
                                VerticalAlignment="Center"
                                KeyDown="OnFilterKeyDown" />

                    <ui:TextBlock Grid.Column="3"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  FontTypography="Body"
                                  Text="Min size:" />

                    <ComboBox Grid.Column="4"
                              Name="SizeFilterBox"
                              VerticalAlignment="Center"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Any size"   Tag="0" />
                        <ComboBoxItem Content="≥ 1 KB"     Tag="1024" />
                        <ComboBoxItem Content="≥ 100 KB"   Tag="102400" />
                        <ComboBoxItem Content="≥ 1 MB"     Tag="1048576" />
                        <ComboBoxItem Content="≥ 10 MB"    Tag="10485760" />
                        <ComboBoxItem Content="≥ 100 MB"   Tag="104857600" />
                        <ComboBoxItem Content="≥ 1 GB"     Tag="1073741824" />
                    </ComboBox>

                    <ui:Button Grid.Column="6"
                               Content="Apply"
                               Icon="{ui:SymbolIcon Search24}"
                               Click="OnApplyFilterClicked" />
                </Grid>
            </Border>

            <!-- ── Summary cards ─────────────────────────────────────────── -->
            <Grid Grid.Row="2" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="INDEXED FILES" />
                        <ui:TextBlock Name="TotalFilesText" FontTypography="Title" Margin="0,4,0,0" Text="—" />
                        <ui:TextBlock Name="TotalFoldersText" FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="TOP FILE TYPE" />
                        <ui:TextBlock Name="TopCategoryName" FontTypography="Title" Margin="0,4,0,0" Text="—" />
                        <ui:TextBlock Name="TopCategoryCount" FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="DRIVES DETECTED" />
                        <ui:TextBlock Name="DriveCountText" FontTypography="Title" Margin="0,4,0,0" Text="—" />
                        <ui:TextBlock Name="DriveNamesText" FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Distribution header ───────────────────────────────────── -->
            <ui:TextBlock Grid.Row="3" FontTypography="Subtitle" Margin="0,0,0,14"
                          Text="File Type Distribution" />

            <!-- ── Donut chart + legend ───────────────────────────────────── -->
            <Grid Grid.Row="4" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <Canvas Name="PieCanvas" Width="210" Height="210" />
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <ItemsControl Name="CategoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type statistics:FileTypeCategory}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Brush}" />

                                    <ui:TextBlock Grid.Column="1" Margin="8,0,8,0"
                                                  VerticalAlignment="Center"
                                                  FontTypography="Body"
                                                  Text="{Binding Name}" />

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Rectangle Height="8" RadiusX="4" RadiusY="4"
                                                   Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Rectangle Height="8" RadiusX="4" RadiusY="4"
                                                   HorizontalAlignment="Left"
                                                   Fill="{Binding Brush}">
                                            <Rectangle.Width>
                                                <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                    <Binding Path="Percentage" />
                                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth" />
                                                </MultiBinding>
                                            </Rectangle.Width>
                                        </Rectangle>
                                    </Grid>

                                    <ui:TextBlock Grid.Column="3" Margin="8,0,0,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                                  FontTypography="Body"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Text="{Binding FormattedPercentage}" />

                                    <ui:TextBlock Grid.Column="4" Margin="8,0,0,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                                  FontTypography="BodyStrong"
                                                  Text="{Binding FormattedCount}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- ── Drives header ─────────────────────────────────────────── -->
            <ui:TextBlock Grid.Row="5" FontTypography="Subtitle" Margin="0,0,0,14"
                          Text="Disk Space" />

            <!-- ── Drive cards ───────────────────────────────────────────── -->
            <ItemsControl Grid.Row="6" Name="DriveList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type statistics:DriveStats}">
                        <Border Margin="0,0,8,8" Width="220"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                    <ui:TextBlock HorizontalAlignment="Right" FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Text="{Binding UsedPercent, StringFormat={}{0:F0}% used}" />
                                </Grid>
                                <Grid Height="8" Margin="0,0,0,8">
                                    <Rectangle RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Rectangle RadiusX="4" RadiusY="4"
                                               HorizontalAlignment="Left" Fill="#0078D4">
                                        <Rectangle.Width>
                                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                <Binding Path="UsedPercent" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Rectangle.Width>
                                    </Rectangle>
                                </Grid>
                                <Grid>
                                    <ui:TextBlock FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Text="{Binding FormattedUsed, StringFormat=Used: {0}}" />
                                    <ui:TextBlock HorizontalAlignment="Right" FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Text="{Binding FormattedTotal, StringFormat=Total: {0}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
</Page>
